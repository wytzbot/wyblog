# Server-only variables. Do NOT put these in VITE_* variables.
APP_URL=https://your-wyblog-domain.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-wyblog-domain.example/api/auth/callback
BLOGGER_TOKEN_ENCRYPTION_KEY=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Gemini: cheapest suggestion model first, stronger daily diagnosis model second.
GEMINI_API_KEY=
GEMINI_SUGGESTION_MODEL=gemini-2.5-flash-lite
GEMINI_DIAGNOSIS_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Flutterwave v4 only. WyBlog intentionally does NOT define a Flutterwave webhook route
# because the merchant webhook is already occupied by WyteLab. Renewals are polled by cron.
FLW_ENV=live
FLW_BASE_URL=https://f4bexperience.flutterwave.com
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENCRYPTION_KEY=
FLW_PRO_USD=1
FLW_PRO_NGN=1000

# Vercel cron protection
CRON_SECRET=
